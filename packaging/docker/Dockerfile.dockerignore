# Build context filter for packaging/docker/Dockerfile. BuildKit reads it instead of a root
# .dockerignore because it sits next to the Dockerfile with a matching name.
#
# Allow list: only the sources the image is built from enter the context. Later lines win,
# so the exclusions below also apply inside the allowed directories.
*
!go.mod
!go.sum
!cmd/
!internal/
!web/

# Version control and local tooling state
.git
.claude

# Local environment files may hold secrets and must never reach a build layer
**/.env*
**/*.local

# Dependencies and build output; the web stage installs and builds its own
**/node_modules
bin
**/*.exe
**/*.test
internal/adapters/http/webui/dist
web/**/dist
**/*.tsbuildinfo

# Generated test media (scripts/gen-testmedia)
testdata/media

# Coverage and Playwright output
**/coverage
**/coverage.out
**/coverage.html
**/playwright-report
**/test-results
**/blob-report
