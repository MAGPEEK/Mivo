#!/bin/sh
# shellcheck source-path=SCRIPTDIR
# Runs first in an upgrade, as the new version's preupgrade (ADR 0026 section 10, task SPK-17),
# as the package user. DSM keeps var (config.yaml, data/, the log) and replaces target and tmp.
#
# The only job: 0.1.0-alpha.2 wrote library paths in the form /var/packages/<id>/shares/<share>,
# a link that exists only while the package holds a data-share resource, which this version does
# not. The script records the resolved target of every such link (readlink -f, with the volume
# root stripped: /volumeN/<share>) in $PKG_SHARE_RECORD_FILE, one "<share><TAB><target>" line
# each, for postupgrade to rewrite config.yaml. Nothing recorded means no file. It never fails:
# a non-zero exit would abort the upgrade, and postupgrade has a fallback for a missing record.
set -eu

# The shared files live next to this script, wherever DSM keeps it.
case "$0" in
*/*) PKG_SCRIPT_DIR=${0%/*} ;;
*) PKG_SCRIPT_DIR=. ;;
esac
if [ ! -r "$PKG_SCRIPT_DIR/common.sh" ]; then
	exit 0
fi
# shellcheck source=common.sh
. "$PKG_SCRIPT_DIR/common.sh"
pkg_load_package_env || exit 0
pkg_require_dsm_environment || exit 0
pkg_derive_paths

umask "$PKG_FILE_UMASK"
link_prefix=$(pkg_share_link_prefix)
record_temp_file=$PKG_SHARE_RECORD_FILE.new
rm -f "$record_temp_file" 2>/dev/null || :
record_failed=no
for share_link in "$link_prefix"*; do
	if [ ! -L "$share_link" ]; then
		continue
	fi
	share_target=$(readlink -f "$share_link" 2>/dev/null) || continue
	share_target=${share_target#"$PKG_VOLUMES_ROOT"}
	if ! pkg_is_volume_path "$share_target"; then
		continue
	fi
	if ! printf '%s\t%s\n' "${share_link#"$link_prefix"}" "$share_target" >>"$record_temp_file"; then
		record_failed=yes
		break
	fi
done
if [ "$record_failed" = yes ]; then
	# No record is better than a partial one; postupgrade falls back to the volume directories.
	rm -f "$record_temp_file" 2>/dev/null || :
	pkg_error "cannot write $record_temp_file; postupgrade will look for the shares on the volumes"
elif [ -f "$record_temp_file" ]; then
	# The old record goes only when a new one replaces it.
	if mv -f "$record_temp_file" "$PKG_SHARE_RECORD_FILE" 2>/dev/null; then
		echo "recorded the share links of the previous version in $PKG_SHARE_RECORD_FILE"
	else
		rm -f "$record_temp_file" 2>/dev/null || :
	fi
fi
exit 0
