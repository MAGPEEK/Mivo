# shellcheck shell=sh disable=SC2034 # read by common.sh
# Brand values of the package scripts (ADR 0026 section 6). Template: the staging step fills
# the tokens from internal/platform/brand and config.DefaultPort (SPK-03, SPK-14). Values stay
# inside single quotes, so they must not contain a single quote.
ID='@ID@'
DISPLAY_NAME='@DISPLAY_NAME@'
ENV_PREFIX='@ENV_PREFIX@'
PORT='@PORT@'
