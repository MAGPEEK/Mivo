#!/bin/sh
# shellcheck source-path=SCRIPTDIR
# Runs after the package files are removed (ADR 0026 section 10, task SPK-06), as the package
# user; also during an upgrade, as the old version's postuninst.
#
# DSM never removes var and home (DSM-NOTES section 10), so the user's database, settings and
# logs survive an uninstall by default (OD-SPK-8 A). Only when the user ticked "delete" in the
# uninstall wizard (wizard_delete_data=true) during a real uninstall (SYNOPKG_PKG_STATUS
# UNINSTALL, never UPGRADE) it deletes the contents of $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME,
# and only when both are, as given and with every link resolved, this package's var and home
# directories in DSM's layout (pkg_resolve_package_directory). It deletes below the resolved
# directories. Shared folders and media are never touched: nothing here follows a link out of
# these directories.
#
# Test-only variable (packaging/synology/test; DSM never sets it):
#   PKG_TEST_VOLUMES_ROOT  directory that holds the volume* directories instead of / (common.sh
#                          PKG_VOLUMES_ROOT)
set -eu

if [ "${SYNOPKG_PKG_STATUS:-}" != UNINSTALL ] || [ "${wizard_delete_data:-}" != true ]; then
	exit 0
fi

# The shared files live next to this script, wherever DSM keeps it.
case "$0" in
*/*) PKG_SCRIPT_DIR=${0%/*} ;;
*) PKG_SCRIPT_DIR=. ;;
esac
if [ ! -r "$PKG_SCRIPT_DIR/common.sh" ]; then
	printf '%s\n' "$PKG_SCRIPT_DIR/common.sh is missing; the data in var was not deleted" >&2
	exit 1
fi
# shellcheck source=common.sh
. "$PKG_SCRIPT_DIR/common.sh"
pkg_load_package_env || exit 1
pkg_require_dsm_environment || exit 1

# resolve_data_dir prints the resolved directory of kind $1 (var or home) given as $2, or tells
# the user why nothing is deleted and leaves the script.
resolve_data_dir() {
	if pkg_resolve_package_directory "$1" "$2"; then
		return 0
	fi
	pkg_tell_user "$(pkg_localized \
		"not deleting $2: it is not the $1 directory of the package $ID; the data of $DISPLAY_NAME was kept" \
		"$2 wird nicht gelöscht: es ist nicht das $1-Verzeichnis des Pakets $ID; die Daten von $DISPLAY_NAME bleiben erhalten")"
	exit 1
}

# Both directories are checked before anything is deleted, so a bad home keeps var as well.
var_dir=$(resolve_data_dir var "$SYNOPKG_PKGVAR") || exit 1
home_dir=$(resolve_data_dir home "$SYNOPKG_PKGHOME") || exit 1
delete_status=0
for data_dir in "$var_dir" "$home_dir"; do
	pkg_remove_directory_contents "$data_dir" || delete_status=1
done
if [ "$delete_status" -ne 0 ]; then
	pkg_tell_user "$(pkg_localized \
		"cannot delete all data of $DISPLAY_NAME in $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME" \
		"Die Daten von $DISPLAY_NAME in $SYNOPKG_PKGVAR und $SYNOPKG_PKGHOME konnten nicht vollständig gelöscht werden")"
	exit 1
fi
echo "deleted the data of $DISPLAY_NAME in $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME"
exit 0
