#!/bin/sh
# shellcheck source-path=SCRIPTDIR
# Runs after the package files are removed (ADR 0026 section 10, task SPK-06), as the package
# user; also during an upgrade, as the old version's postuninst.
#
# DSM never removes var and home (DSM-NOTES section 10), so the user's database, settings and
# logs survive an uninstall by default (OD-SPK-8 A). Only when the user ticked "delete" in the
# uninstall wizard (wizard_delete_data=true) during a real uninstall (SYNOPKG_PKG_STATUS
# UNINSTALL, never UPGRADE) it deletes the contents of $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME,
# and only when both are directories of this package. Shared folders and media are never
# touched: nothing here follows a link out of these directories.
set -eu

if [ "${SYNOPKG_PKG_STATUS:-}" != UNINSTALL ] || [ "${wizard_delete_data:-}" != true ]; then
	exit 0
fi

# The shared files live next to this script, wherever DSM keeps it.
case "$0" in
*/*) PKG_SCRIPT_DIR=${0%/*} ;;
*) PKG_SCRIPT_DIR=. ;;
esac
if [ ! -r "$PKG_SCRIPT_DIR/common.sh" ]; then
	printf '%s\n' "$PKG_SCRIPT_DIR/common.sh is missing; the data in var was not deleted" >&2
	exit 1
fi
# shellcheck source=common.sh
. "$PKG_SCRIPT_DIR/common.sh"
pkg_load_package_env || exit 1
pkg_require_dsm_environment || exit 1

for data_dir in "$SYNOPKG_PKGVAR" "$SYNOPKG_PKGHOME"; do
	if ! pkg_is_package_directory "$data_dir"; then
		pkg_tell_user "not deleting $data_dir: it is not a directory of the package $ID; the data of $DISPLAY_NAME was kept"
		exit 1
	fi
done
delete_status=0
for data_dir in "$SYNOPKG_PKGVAR" "$SYNOPKG_PKGHOME"; do
	pkg_remove_directory_contents "$data_dir" || delete_status=1
done
if [ "$delete_status" -ne 0 ]; then
	pkg_tell_user "cannot delete all data of $DISPLAY_NAME in $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME"
	exit 1
fi
echo "deleted the data of $DISPLAY_NAME in $SYNOPKG_PKGVAR and $SYNOPKG_PKGHOME"
exit 0
