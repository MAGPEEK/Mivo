#!/bin/sh
# shellcheck source-path=SCRIPTDIR
# Runs after package.tgz is extracted (ADR 0026 section 10, task SPK-17), as the package user.
#
# Creates the server's data, cache and transcode directories that are missing (0750) and nothing
# else, then records the bundled FFmpeg's capabilities in the package log (report only, task
# M3-16j). It writes no config.yaml: a fresh installation starts with zero libraries, which the user
# adds in the web app (Settings > Libraries). An existing config.yaml, from an earlier
# installation or a kept uninstall, is never touched. A non-zero exit marks the package as
# damaged in Package Center; the reason goes to $SYNOPKG_TEMP_LOGFILE.
set -eu

# The shared files live next to this script, wherever DSM keeps it.
case "$0" in
*/*) PKG_SCRIPT_DIR=${0%/*} ;;
*) PKG_SCRIPT_DIR=. ;;
esac
if [ ! -r "$PKG_SCRIPT_DIR/common.sh" ]; then
	printf '%s\n' "$PKG_SCRIPT_DIR/common.sh is missing; the package file is damaged" >&2
	exit 1
fi
# shellcheck source=common.sh
. "$PKG_SCRIPT_DIR/common.sh"
pkg_load_package_env || exit 1
pkg_require_dsm_environment || exit 1
pkg_derive_paths

umask "$PKG_FILE_UMASK"
if ! pkg_create_server_dirs; then
	pkg_tell_user "$(pkg_localized \
		"cannot create the directories of $DISPLAY_NAME in $SYNOPKG_PKGVAR and $SYNOPKG_PKGTMP" \
		"Die Verzeichnisse von $DISPLAY_NAME in $SYNOPKG_PKGVAR und $SYNOPKG_PKGTMP konnten nicht angelegt werden")"
	exit 1
fi
pkg_report_ffmpeg_capabilities
exit 0
