{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests that read package files (theme.css) need Node APIs. They live outside src so the
    // shipped tokens keep `types: []`.
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [".", "../src"]
}
