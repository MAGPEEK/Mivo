{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests that read installed package files need Node APIs. They live outside src so the
    // browser app keeps its DOM-only types.
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["."]
}
